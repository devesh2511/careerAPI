# Copy to .env and fill in. Get the pooled URL from the Layerbase dashboard → Quick Connect.
DATABASE_URL=postgresql://user:password@your-db.cloud.layerbase.dev/db?sslmode=verify-full
PORT=3000
# Comma-separated origins allowed to call the API (the careerAI frontend)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Admin password-reset emails via Gmail SMTP. SMTP_PASS is a Google app password
# (myaccount.google.com/apppasswords; needs 2-Step Verification). Leave both blank
# locally to print emails to the console.
SMTP_USER=
SMTP_PASS=
# My Career Space news providers (src/Services/news/providers/). Google News RSS
# needs no key and is always on; GNews is on when GNEWS_API_KEY is set
# (gnews.io; GNEWS_MAX = its articles per request, 10 on the free plan).
# NEWS_DISABLE turns providers off by name, e.g. "Google News".
GNEWS_API_KEY=
GNEWS_MAX=10
NEWS_DISABLE=
NEWS_CACHE_HOURS=12
