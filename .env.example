# Copy to .env and fill in. Get the pooled URL from the Layerbase dashboard → Quick Connect.
DATABASE_URL=postgresql://user:password@your-db.cloud.layerbase.dev/db?sslmode=verify-full
PORT=3000
# Comma-separated origins allowed to call the API (the careerAI frontend)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Admin password-reset emails via Resend (https://resend.com). EMAIL_FROM must be
# on a domain verified in Resend. Leave the key blank locally to print emails to the console.
RESEND_API_KEY=
EMAIL_FROM=careerAI <no-reply@your-domain.com>
