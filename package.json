{
  "name": "career-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for careerAI, backed by a Layerbase PostgreSQL database",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "migrate": "node --env-file=.env scripts/migrate.js",
    "create-admin": "node --env-file=.env scripts/create-admin.js",
    "reset-admin-password": "node --env-file=.env scripts/reset-admin-password.js"
  },
  "engines": {
    "node": ">=20.6"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
